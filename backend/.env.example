# Backend Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit the .env file to Git

# --- LLM API Keys ---
# Groq (used for fast inference with Llama/DeepSeek models)
GROQ_API_KEY=your_groq_api_key_here

# DeepSeek (optional, used as alternative LLM)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# GraphRAG / Cloudflare AI (used for embedding & knowledge graph)
GRAPHRAG_API_KEY=your_graphrag_api_key_here

# --- (Optional) Vercel deployment token ---
# VERCEL_TOKEN=your_vercel_token_here
