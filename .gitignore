# =============================================================================
# HUST Q&A Chatbot — .gitignore
# =============================================================================

# ---------------------------------------------------------------------------
# Secrets & Environment Variables (NEVER commit these)
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# Python — Backend
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
.venv/
venv/
ENV/
env/
.Python

# ---------------------------------------------------------------------------
# Databases & Persistent Storage
# ---------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# GraphRAG — Selectively ignore generated/large files
# Keep:  output/*.parquet  (pre-built knowledge graph, needed by Docker)
# Ignore: caches, indexes, large binaries
# ---------------------------------------------------------------------------
backend/cache/
backend/logs/
backend/tmp/
backend/torchinductor*/
backend/input/book.txt

# Output: ignore large/generated files, KEEP parquet files
backend/output/lancedb/
backend/output/naive_index/
backend/output/*.pkl
backend/output/*.graphml
backend/output/context.json
backend/output/stats.json

# Generated ML data files (non-parquet)
*.faiss
*.bin
*.pt
*.ckpt

# ---------------------------------------------------------------------------
# Node.js — Frontend
# ---------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/

# Next.js
.next/
out/

# Build output
dist/
build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Vercel
# ---------------------------------------------------------------------------
.vercel/
.vercel

# ---------------------------------------------------------------------------
# IDE & Editor
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ---------------------------------------------------------------------------
# OS
# ---------------------------------------------------------------------------
Thumbs.db
Desktop.ini
ehthumbs.db
*.stackdump
[Dd]esktop.ini

# ---------------------------------------------------------------------------
# Misc / Internal Tools
# ---------------------------------------------------------------------------
.agents/
backend-repo/
.npm-cache/
.npm-cache
cloudflared
skills-lock.json

# Scratch / debug scripts
backend/scratch_*.py
backend/test_config.py
backend/patch_graphrag.py
backend/export_graphml.py
backend/standard_indent.py
